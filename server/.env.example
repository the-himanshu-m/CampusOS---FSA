# CampusOS Backend Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusos?retryWrites=true&w=majority
JWT_SECRET=your_jwt_super_secret_key_change_in_production_123456789
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Optional: Set to 'true' to explicitly use local embedded MongoDB
USE_IN_MEMORY_DB=false
